ANTHROPIC_API_KEY=sk-ant-...
# Development only: let the agent see facts not yet verified
# ONEVISIT_INCLUDE_DRAFTS=1

# ---------------------------------------------------------------- stack Docker (kit OneVisit)
# Copia in .env con `make env` e completa i valori. .env non va mai nel repository.

# ---------------------------------------------------------------- database
# Utente proprietario: esegue migrazioni e comandi amministrativi.
POSTGRES_USER=onevisit_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=onevisit
# Ruoli dei servizi (creati alla prima inizializzazione di Postgres).
APP_ASSISTANT_PASSWORD=change-me-assistant
APP_NOTIFIER_PASSWORD=change-me-notifier
APP_ANALYSIS_PASSWORD=change-me-analysis
APP_DASHBOARD_PASSWORD=change-me-dashboard

# ---------------------------------------------------------------- Claude
ONEVISIT_MODEL_CONVERSATION=claude-sonnet-5-5
ONEVISIT_MODEL_FAST=claude-haiku-4-5-20251001

# ---------------------------------------------------------------- chiavi
# Ognuna 32 byte in base64:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
ONEVISIT_ENCRYPTION_KEY=
ONEVISIT_HMAC_KEY=
ONEVISIT_LINK_SIGNING_KEY=
ONEVISIT_SESSION_SECRET=

# ---------------------------------------------------------------- SMS
ONEVISIT_SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ONEVISIT_SMS_FROM=

# ---------------------------------------------------------------- email
# In sviluppo Mailpit: nessuna email esce davvero.
ONEVISIT_SMTP_HOST=mailpit
ONEVISIT_SMTP_PORT=1025
ONEVISIT_SMTP_USER=
ONEVISIT_SMTP_PASSWORD=
ONEVISIT_SMTP_STARTTLS=false
ONEVISIT_EMAIL_FROM="OneVisit <noreply@example.org>"

# ---------------------------------------------------------------- comportamento
ONEVISIT_ENVIRONMENT=development
ONEVISIT_PUBLIC_BASE_URL=http://localhost:8000
ONEVISIT_TIMEZONE=Europe/Rome
ONEVISIT_DEMO_MODE=false
# In demo un giorno dura 60 secondi.
ONEVISIT_DEMO_SECONDS_PER_DAY=60
ONEVISIT_REMINDER_DAYS_BEFORE=3
ONEVISIT_K_THRESHOLD=5
ONEVISIT_GAP_THRESHOLD_CASES=5
ONEVISIT_GAP_THRESHOLD_WEEKS=4
ONEVISIT_SOURCE_STALE_DAYS=30
ONEVISIT_COST_PER_SLOT_EUR=0

# ---------------------------------------------------------------- produzione
ONEVISIT_IMAGE=onevisit:latest
ASSISTANT_DOMAIN=onevisit.example.org
DASHBOARD_DOMAIN=pannello.onevisit.example.org
GATEWAY_DOMAIN=gateway.onevisit.example.org
ACME_EMAIL=admin@example.org
