# Streamlit Community Cloud: paste these in the app's Settings → Secrets (never commit the real file).
# With a key the deployed app answers with Claude by default; ?demo=1 in the URL forces the demo.
ANTHROPIC_API_KEY = "sk-ant-..."

# Spending caps for the public app (Claude calls: conversation turns, next actions, translations,
# report classifications, drafts). When a cap is reached the session carries on in demo mode.
ONEVISIT_MAX_CALLS_PER_SESSION = 40
ONEVISIT_MAX_CALLS_PER_DAY = 1500
